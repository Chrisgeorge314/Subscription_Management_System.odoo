generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("STAFF") // ADMIN, STAFF, CUSTOMER
  avatar       String?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  resetToken   String?
  resetExpires DateTime?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  phone          String?
  company        String?
  billingAddress String?
  city           String?
  state          String?
  postalCode     String?
  country        String         @default("India")
  taxNumber      String?        // GSTIN
  currency       String         @default("INR")
  status         String         @default("ACTIVE")
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          User[]
  quotations     Quotation[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
}

model Product {
  id                String             @id @default(cuid())
  name              String
  code              String             @unique
  type              String             @default("SERVICE") // SERVICE, PHYSICAL, DIGITAL
  salesPrice        Float
  costPrice         Float              @default(0)
  description       String?
  status            String             @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  variants          ProductVariant[]
  plans             SubscriptionPlan[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  sku               String?
  additionalPrice   Float              @default(0)
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

model SubscriptionPlan {
  id                String          @id @default(cuid())
  name              String
  code              String          @unique
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  billingFrequency  String          @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  price             Float
  minQuantity       Int             @default(1)
  startDate         DateTime?
  endDate           DateTime?
  autoCloseOnEnd    Boolean         @default(true)
  allowPause        Boolean         @default(true)
  allowEarlyClosure Boolean         @default(true)
  allowRenewal      Boolean         @default(true)
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subscriptions     Subscription[]
  quotationLines    QuotationLine[]
}

model QuotationTemplate {
  id           String      @id @default(cuid())
  name         String
  description  String?
  validityDays Int         @default(30)
  defaultTerms String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quotations   Quotation[]
}

model Quotation {
  id                      String             @id @default(cuid())
  quotationNumber         String             @unique
  customerId              String
  customer                Customer           @relation(fields: [customerId], references: [id])
  templateId              String?
  template                QuotationTemplate? @relation(fields: [templateId], references: [id])
  status                  String             @default("DRAFT") // DRAFT, SENT, ACCEPTED, CONVERTED, EXPIRED, CANCELLED
  issueDate               DateTime           @default(now())
  validUntil              DateTime
  subtotal                Float              @default(0)
  taxAmount               Float              @default(0)
  discountAmount          Float              @default(0)
  totalAmount             Float              @default(0)
  terms                   String?
  notes                   String?
  convertedSubscriptionId String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  lines                   QuotationLine[]
}

model QuotationLine {
  id             String            @id @default(cuid())
  quotationId    String
  quotation      Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant?   @relation(fields: [variantId], references: [id])
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id])
  description    String?
  quantity       Int               @default(1)
  unitPrice      Float
  discountAmount Float             @default(0)
  taxRate        Float             @default(0)
  taxAmount      Float             @default(0)
  totalAmount    Float
  createdAt      DateTime          @default(now())
}

model Subscription {
  id                 String                @id @default(cuid())
  subscriptionNumber String                @unique
  customerId         String
  customer           Customer              @relation(fields: [customerId], references: [id])
  planId             String
  plan               SubscriptionPlan      @relation(fields: [planId], references: [id])
  status             String                @default("ACTIVE") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED, EXPIRED
  billingFrequency   String                @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  paymentTerms       String                @default("Net 15")
  startDate          DateTime              @default(now())
  expiryDate         DateTime?
  currentPeriodStart DateTime              @default(now())
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime
  pauseDate          DateTime?
  resumeDate         DateTime?
  closedDate         DateTime?
  cancelReason       String?
  autoRenew          Boolean               @default(true)
  subtotal           Float                 @default(0)
  taxAmount          Float                 @default(0)
  discountAmount     Float                 @default(0)
  totalAmount        Float                 @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  lines              SubscriptionLine[]
  invoices           Invoice[]
  history            SubscriptionHistory[]
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String?
  quantity       Int             @default(1)
  unitPrice      Float
  discountAmount Float           @default(0)
  taxRate        Float           @default(0)
  taxAmount      Float           @default(0)
  totalAmount    Float
  createdAt      DateTime        @default(now())
}

model SubscriptionHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         String       // CREATED, ACTIVATED, PAUSED, RESUMED, RENEWED, CLOSED, INVOICE_GENERATED
  previousStatus String?
  newStatus      String
  performedBy    String?
  notes          String?
  createdAt      DateTime     @default(now())
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  status             String        @default("CONFIRMED") // DRAFT, CONFIRMED, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  subtotal           Float         @default(0)
  taxAmount          Float         @default(0)
  discountAmount     Float         @default(0)
  totalAmount        Float         @default(0)
  paidAmount         Float         @default(0)
  outstandingAmount  Float         @default(0)
  paymentTerms       String        @default("Net 15")
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lines              InvoiceLine[]
  payments           Payment[]
}

model InvoiceLine {
  id             String          @id @default(cuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String
  quantity       Int             @default(1)
  unitPrice      Float
  discountAmount Float           @default(0)
  taxRate        Float           @default(0)
  taxAmount      Float           @default(0)
  totalAmount    Float
  createdAt      DateTime        @default(now())
}

model TaxRule {
  id                     String   @id @default(cuid())
  name                   String
  code                   String   @unique
  rate                   Float
  type                   String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  applicableProductTypes String   @default("ALL")
  isCompound             Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model DiscountRule {
  id                String    @id @default(cuid())
  name              String
  code              String    @unique
  type              String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  value             Float
  scope             String    @default("SUBSCRIPTION") // SUBSCRIPTION, PRODUCT
  minPurchaseAmount Float?
  minQuantity       Int?
  maxUsageCount     Int?
  currentUsageCount Int       @default(0)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Payment {
  id             String   @id @default(cuid())
  paymentNumber  String   @unique
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amount         Float
  paymentMethod  String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, CARD, OTHER
  paymentDate    DateTime @default(now())
  transactionRef String?
  status         String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  notes          String?
  recordedBy     String?
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
